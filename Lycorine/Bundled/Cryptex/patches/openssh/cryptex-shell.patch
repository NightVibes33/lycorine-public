 /* Debugging messages */
 static struct sshbuf *auth_debug;
 
+static char *
+cryptex_root_shell(const struct passwd *pw)
+{
+	const char *mount, *shell;
+	char *path;
+
+	if (pw->pw_uid != 0 || strcmp(pw->pw_name, "root") != 0)
+		return NULL;
+	mount = getenv("CRYPTEX_MOUNT_PATH");
+	shell = getenv("CRYPTEX_SHELL");
+	if (mount == NULL || mount[0] != '/' ||
+	    shell == NULL || shell[0] != '/')
+		return NULL;
+	xasprintf(&path, "%s%s", mount, shell);
+	return path;
+}
